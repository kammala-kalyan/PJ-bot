# Copy this file to .env and fill it in. Never share .env.

# From https://my.telegram.org → API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Printed by: python login.py
SESSION_STRING=

# From @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyZ

# Your new private group with Topics ON (id from list_chats.py, starts with -100)
TARGET_GROUP_ID=-1001234567890

# Placement group(s) to read. Ids from list_chats.py or @usernames, comma-separated
SOURCE_CHATS=-1009876543210

# Free key from https://aistudio.google.com/apikey (leave empty = keyword rules only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite-preview,gemini-2.5-flash
# Seconds between AI calls; 6 keeps you inside the free tier's per-minute limit
AI_MIN_INTERVAL=6

# Past messages to sort on first run: 0 = whole history, 500 = last 500, -1 = none
BACKFILL_LIMIT=0
# Only sort history from the last N days (0 = no age limit)
BACKFILL_DAYS=30
# 1 = use AI for history too (uses free daily quota); 0 = keyword rules for history, AI for new messages
BACKFILL_AI=0

# Attachments (PDF JDs, images) up to this size are copied into the tab
MAX_MEDIA_MB=20
DB_PATH=data/state_v2.db

# A line about you (resumes in resumes/ are the main input). Example below - edit it.
PROFILE=B.Tech CSE (Data Science), 2027 batch. Notify me of any job whose requirements match my skills and projects in my resume, whatever the job title. Open to any location in India or remote.
# Off-campus job channels/groups to read (ids or @usernames, comma-separated). Leave empty for now.
OFFCAMPUS_CHATS=
# Days of history to check for off-campus channels on first run
OFFCAMPUS_BACKFILL_DAYS=7

# Job-alert emails (LinkedIn, Naukri, Indeed...). App Password from https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional second inbox
GMAIL_ADDRESS2=
GMAIL_APP_PASSWORD2=
